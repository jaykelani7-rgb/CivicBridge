# Canonical backend services. Keep these server-only; never rename to NEXT_PUBLIC_*.
CITIZEN_CHANNELS_URL=http://127.0.0.1:8000
DATA_INTELLIGENCE_URL=http://127.0.0.1:8002
POLICY_IMPACT_URL=http://127.0.0.1:8003
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
CLOUD_RUN_AUTH_MODE=auto
BFF_REQUEST_TIMEOUT_MS=15000

# Staff access. Use firebase in production. Development mode is rejected in production.
STAFF_AUTH_MODE=firebase
FIREBASE_PROJECT_ID=

# Optional local-only staff role when STAFF_AUTH_MODE=development.
NEXT_PUBLIC_CIVICBRIDGE_DEV_ROLE=

# Demo content is opt-in and must always be visibly labelled.
NEXT_PUBLIC_DEMO_MODE=false
RUN_LIVE_FRONTEND_INTEGRATION_TESTS=false
