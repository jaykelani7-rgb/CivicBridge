# ==========================================
# CivicBridge AI - Environment Configuration
# ==========================================

# Application Port and Environment
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development  # development, staging, production

# Google Cloud Settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1 # Region for Vertex AI / Cloud Run
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
SIMILARITY_PROVIDER=vertex
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
DUPLICATE_SIMILARITY_THRESHOLD=0.88
RELATED_SIMILARITY_THRESHOLD=0.78
VERTEX_EMBEDDING_TIMEOUT_SECONDS=30
VERTEX_EMBEDDING_MAX_RETRIES=3
VERTEX_EMBEDDING_BATCH_SIZE=20
RUN_VERTEX_INTEGRATION_TESTS=false

# Local Vertex authentication uses `gcloud auth application-default login`.
# Cloud Run uses its attached runtime service account. Do not use JSON keys or Gemini API keys.

# API Configuration and Mocks
# Set to 'true' to run without live Google Cloud APIs (STT, Translate, Vertex AI, Firestore)
USE_MOCK_SERVICES=true

# Firebase / Firestore Configurations
FIREBASE_DATABASE_ID=(default)

# API Keys (For optional third-party integrations or Maps API configurations)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# AI Normalization service (Shreyank) -- services/ai_normalization/
GEMINI_MODEL_NAME=gemini-1.5-flash
CITIZEN_CHANNELS_URL=http://127.0.0.1:8000
AI_NORMALIZATION_PORT=8001
CONFIDENCE_REVIEW_THRESHOLD=0.60

# Policy + Impact service (Sharmad) -- points at the AI Normalization service above
SHREYANK_AI_SERVICE_URL=http://127.0.0.1:8001
ENABLE_MOCK_STUBS=true
