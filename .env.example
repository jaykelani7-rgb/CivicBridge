# ==========================================
# CivicBridge AI - Environment Configuration
# ==========================================

# Application Port and Environment
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development  # development, staging, production

# Google Cloud Settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1 # Region for Vertex AI / Cloud Run
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
SIMILARITY_PROVIDER=vertex
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
DUPLICATE_SIMILARITY_THRESHOLD=0.88
RELATED_SIMILARITY_THRESHOLD=0.78
VERTEX_EMBEDDING_TIMEOUT_SECONDS=30
VERTEX_EMBEDDING_MAX_RETRIES=3
VERTEX_EMBEDDING_BATCH_SIZE=20
RUN_VERTEX_INTEGRATION_TESTS=false

# Local Vertex authentication uses `gcloud auth application-default login`.
# Cloud Run uses its attached runtime service account. Do not use JSON keys or Gemini API keys.

# API Configuration and Mocks
# Set to 'true' to run without live Google Cloud APIs (STT, Translate, Vertex AI, Firestore)
USE_MOCK_SERVICES=true

# Firebase / Firestore Configurations
FIREBASE_DATABASE_ID=(default)

# API Keys (For optional third-party integrations or Maps API configurations)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# AI Normalization service (Shreyank) -- services/ai_normalization/
GEMINI_MODEL_NAME=gemini-1.5-flash
CITIZEN_CHANNELS_URL=http://127.0.0.1:8000
AI_NORMALIZATION_PORT=8001
CONFIDENCE_REVIEW_THRESHOLD=0.60
AI_AUTHENTICATE_CLOUD_RUN=false
AI_EVENT_BUS=memory
AI_PUBSUB_PROJECT=
AI_NORMALIZED_TOPIC=request-normalized-v1
AI_REVIEW_TOPIC=request-needs-review-v1
AI_IDEMPOTENCY_BACKEND=local
AI_BIGQUERY_DATASET=civicbridge_ai_normalization

# Citizen Channels: use memory locally and pubsub on Cloud Run.
CITIZEN_EVENT_BUS=memory
CITIZEN_PUBSUB_PROJECT=
CITIZEN_REQUEST_CREATED_TOPIC=request-created-v1
CITIZEN_REQUEST_CONFIRMED_TOPIC=request-confirmed-v1
CITIZEN_MEDIA_DIR=./data/media

# Policy + Impact service (Sharmad) -- points at the AI Normalization service above
SHREYANK_AI_SERVICE_URL=http://127.0.0.1:8001
ENABLE_MOCK_STUBS=true
DATABASE_PATH=./data/policy_impact.db
JAY_DATA_INTELLIGENCE_URL=http://127.0.0.1:8002
POLICY_AUTHENTICATE_CLOUD_RUN=false
POLICY_EVENT_BUS=memory
POLICY_PUBSUB_PROJECT=
POLICY_IDEMPOTENCY_BACKEND=local
POLICY_BIGQUERY_DATASET=civicbridge_policy_impact
POLICY_RECOMMENDATION_TOPIC=recommendation-created-v1
POLICY_DECISION_TOPIC=policy-decision-recorded-v1
POLICY_PROJECT_TOPIC=project-status-updated-v1
POLICY_IMPACT_TOPIC=impact-metric-updated-v1
