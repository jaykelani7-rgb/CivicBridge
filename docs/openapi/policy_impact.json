  "components": {
    "schemas": {
      "AssignmentRequest": {
        "properties": {
          "department": {
            "type": "string",
            "title": "Department"
          },
          "reviewer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer"
          }
        },
        "type": "object",
        "required": [
          "department"
        ],
        "title": "AssignmentRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImpactMetric": {
        "properties": {
          "metric_id": {
            "type": "string",
            "title": "Metric Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "metric_code": {
            "type": "string",
            "title": "Metric Code"
          },
          "baseline": {
            "type": "number",
            "title": "Baseline"
          },
          "target": {
            "type": "number",
            "title": "Target"
          },
          "current": {
            "type": "number",
            "title": "Current"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "measured_at": {
            "type": "string",
            "title": "Measured At"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence",
            "default": 0.85
          },
          "outcome_status": {
            "type": "string",
            "title": "Outcome Status",
            "default": "improving"
          },
          "recorded_at": {
            "type": "string",
            "title": "Recorded At"
          },
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "impact-metric-1.0.0"
          }
        },
        "type": "object",
        "required": [
          "project_id",
          "metric_code",
          "baseline",
          "target",
          "current",
          "unit",
          "source_id",
          "measured_at",
          "recorded_at"
        ],
        "title": "ImpactMetric"
      },
      "ImpactMetricCreateRequest": {
        "properties": {
          "metric_code": {
            "type": "string",
            "title": "Metric Code",
            "description": "Unique metric identifier, e.g. road_flooding_request_rate"
          },
          "baseline": {
            "type": "number",
            "title": "Baseline",
            "description": "Baseline measurement value"
          },
          "target": {
            "type": "number",
            "title": "Target",
            "description": "Target target value"
          },
          "current": {
            "type": "number",
            "title": "Current",
            "description": "Current measured value"
          },
          "unit": {
            "type": "string",
            "title": "Unit",
            "description": "Measurement unit, e.g. requests_per_10000_people_per_month"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id",
            "description": "Data source reference, e.g. civicbridge_validated_requests"
          },
          "measured_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measured At",
            "description": "ISO timestamp of measurement date"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Measurement data confidence score",
            "default": 0.85
          }
        },
        "type": "object",
        "required": [
          "metric_code",
          "baseline",
          "target",
          "current",
          "unit",
          "source_id"
        ],
        "title": "ImpactMetricCreateRequest"
      },
      "Milestone": {
        "properties": {
          "milestone_id": {
            "type": "string",
            "title": "Milestone Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "pending"
          },
          "target_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Date"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "project_id",
          "title"
        ],
        "title": "Milestone"
      },
      "MilestoneCreateRequest": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "title": "Title"
          },
          "target_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Date"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "MilestoneCreateRequest"
      },
      "PolicyAction": {
        "type": "string",
        "enum": [
          "approve_for_assessment",
          "request_evidence",
          "edit",
          "assign",
          "defer",
          "reject"
        ],
        "title": "PolicyAction"
      },
      "PolicyDecision": {
        "properties": {
          "decision_id": {
            "type": "string",
            "title": "Decision Id"
          },
          "recommendation_id": {
            "type": "string",
            "title": "Recommendation Id"
          },
          "action": {
            "$ref": "#/components/schemas/PolicyAction"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "actor_id": {
            "type": "string",
            "title": "Actor Id"
          },
          "actor_role": {
            "type": "string",
            "title": "Actor Role"
          },
          "decided_at": {
            "type": "string",
            "title": "Decided At"
          },
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "policy-decision-1.0.0"
          }
        },
        "type": "object",
        "required": [
          "recommendation_id",
          "action",
          "reason",
          "actor_id",
          "actor_role",
          "decided_at"
        ],
        "title": "PolicyDecision"
      },
      "PolicyDecisionCreateRequest": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/PolicyAction"
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "title": "Reason",
            "description": "Justification for the human decision"
          },
          "actor_id": {
            "type": "string",
            "title": "Actor Id",
            "description": "ID of the human decision maker"
          },
          "actor_role": {
            "type": "string",
            "title": "Actor Role",
            "description": "Role of the actor, e.g. decision_maker, analyst",
            "default": "decision_maker"
          },
          "assigned_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned To",
            "description": "Department or reviewer if action is assign"
          },
          "edited_fields": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edited Fields",
            "description": "Updated recommendation fields if action is edit"
          }
        },
        "type": "object",
        "required": [
          "action",
          "reason",
          "actor_id"
        ],
        "title": "PolicyDecisionCreateRequest"
      },
      "Project": {
        "properties": {
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "recommendation_id": {
            "type": "string",
            "title": "Recommendation Id"
          },
          "hotspot_id": {
            "type": "string",
            "title": "Hotspot Id"
          },
          "country_code": {
            "type": "string",
            "title": "Country Code",
            "default": "IN"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
