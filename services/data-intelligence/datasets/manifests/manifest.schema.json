{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://civicbridge.example/schemas/official-dataset-manifest-1.0.0.json",
  "title":"CivicBridge official dataset manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["manifest_version","dataset_id","dataset_version","source_id","publisher","dataset_title",
    "country_code","geographic_coverage","time_coverage","retrieved_at","source_url","transformation_notes",
    "confidence","freshness_status","synthetic","assets"],
  "properties":{
    "manifest_version":{"const":"official-dataset-manifest-1.0.0"},
    "dataset_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{2,62}$"},
    "dataset_version":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "source_id":{"type":"string","minLength":3,"maxLength":128},
    "publisher":{"type":"string","minLength":2,"maxLength":300},
    "dataset_title":{"type":"string","minLength":3,"maxLength":500},
    "country_code":{"type":"string","pattern":"^[A-Z]{2}$"},
    "geographic_coverage":{"type":"string","minLength":2,"maxLength":500},
    "time_coverage":{"type":"string","minLength":1,"maxLength":200},
    "retrieved_at":{"type":"string","format":"date"},
    "license":{"type":["string","null"],"maxLength":300},
    "source_url":{"type":"string","format":"uri","pattern":"^https://"},
    "transformation_notes":{"type":"string","minLength":10,"maxLength":2000},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "freshness_status":{"enum":["current","stale","historical"]},
    "synthetic":{"const":false},
    "assets":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/asset"}}
  },
  "$defs":{
    "asset":{
      "type":"object","additionalProperties":false,
      "required":["asset_id","uri","target_table","source_format","normalized_schema_version","description"],
      "properties":{
        "asset_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{2,62}$"},
        "uri":{"type":"string","pattern":"^gs://"},
        "target_table":{"enum":["admin_units","demographic_features","infrastructure_indices","investment_projects"]},
        "source_format":{"enum":["PARQUET","CSV","NEWLINE_DELIMITED_JSON"]},
        "normalized_schema_version":{"const":"official-normalized-1.0.0"},
        "description":{"type":"string","minLength":3,"maxLength":500}
      }
    }
  }
}
