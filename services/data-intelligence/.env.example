# Runtime
CB_MODE=local
CB_ENV=local
CB_SERVICE_PORT=8080
CB_LOG_LEVEL=INFO
CB_STORAGE_BACKEND=sqlite
CB_ANALYTICAL_BACKEND=local
CB_DATABASE_PATH=./data/intelligence.db
CB_FIXTURE_DIR=./fixtures

# Geography and country packs
CB_GEOGRAPHY_PROVIDER=local
CB_ALLOW_LOCAL_FALLBACK=true
CB_COUNTRY_PACKS=IN,BR,ZA
CB_GRID_RESOLUTION=3

# Duplicate detection
CB_DUPLICATE_DISTANCE_KM=15
CB_DUPLICATE_TIME_WINDOW_DAYS=90
CB_DUPLICATE_HIGH_THRESHOLD=0.85
CB_DUPLICATE_REVIEW_THRESHOLD=0.65

# Semantic similarity. Vertex uses Application Default Credentials and automatically
# falls back to the independently usable lexical provider on provider failures.
# Set SIMILARITY_PROVIDER=lexical for credential-free local development.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
SIMILARITY_PROVIDER=vertex
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
DUPLICATE_SIMILARITY_THRESHOLD=0.88
RELATED_SIMILARITY_THRESHOLD=0.78
VERTEX_EMBEDDING_TIMEOUT_SECONDS=30
VERTEX_EMBEDDING_MAX_RETRIES=3
VERTEX_EMBEDDING_BATCH_SIZE=20
RUN_VERTEX_INTEGRATION_TESTS=false

# Scoring and pagination
CB_SCORE_VERSION=priority-1.0.0
CB_DEFAULT_PAGE_SIZE=20
CB_MAX_PAGE_SIZE=100

# Google mode: set CB_MODE=google. Operational storage intentionally remains SQLite.
# Application Default Credentials are used; never place a service-account key here.
CB_BIGQUERY_PROJECT=
CB_BIGQUERY_DATASET=
CB_BIGQUERY_RAW_DATASET=
CB_BIGQUERY_LOCATION=US
CB_BIGQUERY_S2_LEVEL=13
# Durable production delivery ledger; local keeps pipeline/SQLite idempotency.
CB_IDEMPOTENCY_BACKEND=local

# Production Pub/Sub adapter (set CB_EVENT_BUS=pubsub to enable)
CB_EVENT_BUS=memory
CB_PUBSUB_PROJECT=
CB_PUBSUB_TOPIC=hotspot-updated-v1
CB_PUBSUB_SUBSCRIPTION=request-normalized-v1-data-intelligence
